#!/usr/bin/env bash
# Local lifecycle wrapper.  Never reads, writes, or prints IBKR credentials.
set -euo pipefail

root_dir="$(cd "$(dirname "$0")/.." && pwd)"
cd "$root_dir"

case "${1:-}" in
  setup)
    exec ./start_mmr.sh --setup
    ;;
  login)
    mode="${2:---paper}"
    case "$mode" in
      --paper) trading_mode="paper"; read_only="no" ;;
      --live) trading_mode="live"; read_only="yes" ;;
      *) echo "usage: $0 login [--paper|--live]" >&2; exit 2 ;;
    esac
    vnc_password="$(openssl rand -base64 24 | tr -d '=+/\n' | cut -c1-20)"
    export TRADING_MODE="$trading_mode" READ_ONLY_API="$read_only" VNC_SERVER_PASSWORD="$vnc_password"
    docker compose up -d ib-gateway
    cat <<EOF
IB Gateway is starting in ${trading_mode} mode using the operator-authorized .env login.

Create a tunnel from your workstation:
  ssh -L 5901:127.0.0.1:5901 john@187.124.115.209

Then connect a VNC viewer to 127.0.0.1:5901 using this temporary VNC password:
  $vnc_password

For live mode, the Gateway API is read-only. Approve the IBKR MFA request. The VNC password above is only in this
container's transient runtime environment. After Gateway reports logged in,
return here.
EOF
    ;;
  start)
    mode="${2:---paper}"
    case "$mode" in
      --paper|--live) exec ./start_mmr.sh "$mode" ;;
      *) echo "usage: $0 start [--paper|--live]" >&2; exit 2 ;;
    esac
    ;;
  reconnect)
    mode="${2:---paper}"
    case "$mode" in
      --paper|--live) exec ./start_mmr.sh "$mode" --restart-all ;;
      *) echo "usage: $0 reconnect [--paper|--live]" >&2; exit 2 ;;
    esac
    ;;
  tui)
    exec uv run mmr tui
    ;;
  demo)
    exec uv run mmr tui --demo
    ;;
  status)
    exec uv run mmr --json status
    ;;
  doctor)
    exec uv run mmr --json verify
    ;;
  logs)
    exec uv run mmr logs
    ;;
  stop)
    # Stop the named, managed host session when present.  Do not broadly kill
    # Python/Java processes: they may belong to another application.
    if tmux has-session -t mmr-live-readonly 2>/dev/null; then
      tmux send-keys -t mmr-live-readonly C-c
      sleep 2
    fi
    # Stops only this project's compose services; no volumes or user data are removed.
    exec docker compose stop
    ;;
  *)
    echo "usage: $0 {setup|login|start|reconnect|tui|demo|status|doctor|logs|stop}" >&2
    exit 2
    ;;
esac
