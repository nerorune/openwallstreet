#!/usr/bin/env bash
# Local lifecycle wrapper.  Never reads, writes, or prints IBKR credentials.
set -euo pipefail

root_dir="$(cd "$(dirname "$0")/.." && pwd)"
cd "$root_dir"

case "${1:-}" in
  setup)
    exec ./start_mmr.sh --setup
    ;;
  login)
    vnc_password="$(openssl rand -base64 24 | tr -d '=+/\n' | cut -c1-20)"
    export TRADING_MODE=paper VNC_SERVER_PASSWORD="$vnc_password"
    docker compose up -d ib-gateway
    cat <<EOF
IB Gateway is starting in PAPER mode using the operator-authorized .env login.

Create a tunnel from your workstation:
  ssh -L 5901:127.0.0.1:5901 john@187.124.115.209

Then connect a VNC viewer to 127.0.0.1:5901 using this temporary VNC password:
  $vnc_password

Approve the IBKR MFA request. The VNC password above is only in this
container's transient runtime environment. After Gateway reports logged in,
return here.
EOF
    ;;
  start)
    exec ./start_mmr.sh --paper
    ;;
  reconnect)
    exec ./start_mmr.sh --paper --restart-all
    ;;
  tui)
    exec uv run mmr tui
    ;;
  demo)
    exec uv run mmr tui --demo
    ;;
  status)
    exec uv run mmr status --json
    ;;
  doctor)
    exec uv run mmr verify --json
    ;;
  logs)
    exec uv run mmr logs
    ;;
  stop)
    # Stops only this project's compose services; no volumes or user data are removed.
    exec docker compose stop
    ;;
  *)
    echo "usage: $0 {setup|login|start|reconnect|tui|demo|status|doctor|logs|stop}" >&2
    exit 2
    ;;
esac
